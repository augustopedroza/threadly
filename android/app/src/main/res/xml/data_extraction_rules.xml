<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup / transfer rules for Android 12+ (API 31+).
     cloud-backup: included in the user's Google Drive app-data backup, restored
     on reinstall. device-transfer: copied during phone-to-phone setup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="organizer.db"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="organizer.db"/>
    </device-transfer>
</data-extraction-rules>
